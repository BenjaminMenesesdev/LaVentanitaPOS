# .env en la RAIZ del repo, usado por docker-compose.yml.
# No confundir con backend/.env (el de Laravel), que es independiente.

DB_PASSWORD=changeme_local_password

# Generar con: docker compose run --rm backend php artisan key:generate --show
# y pegar el valor completo aqui (incluye el prefijo base64:).
APP_KEY=

# El login actual usa tokens Bearer (Sanctum en modo token, no cookies stateful),
# por lo que esta variable no bloquea /login. Se define de todos modos para evitar
# strings vacios si alguna parte del proyecto usa Sanctum en modo stateful.
SANCTUM_STATEFUL_DOMAINS=localhost
FRONTEND_URL=http://localhost
